# Copy this file to ".env" (same folder) and fill in your key to get AI-generated recommendations.
# Without a key the app uses rule-based recommendations.

# Database. Leave unset to use the local SQLite file backend/householdai.db.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/householdai

# anthropic | openai | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: model name (defaults: anthropic=claude-haiku-5-5, openai=gpt-4o-mini, gemini=gemini-2.0-flash)
LLM_MODEL=

# Create the demo household G1 automatically on first start (1 = yes, 0 = no)
SEED_DEMO_ON_START=1
